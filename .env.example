POSTGRES_DB=biographia
POSTGRES_USER=biographia
POSTGRES_PASSWORD=change-me

SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg2://biographia:change-me@biographia_db:5432/biographia

# Docker-internal on the local stack (http://dominex_app:5000); public URL
# on the real server (see dominex/DEPLOYMENT.md).
DOMINEX_API_BASE_URL=http://dominex_app:5000
# Issued in Dominex Настройки -> "Ключи Identity-API" (code=biographia) -
# per-service key, see biographia TZ section 2.2. Shown once at creation.
DOMINEX_API_KEY=change-me

# Must match the same value already set in dominex/.env and ssod_auth/.env.
SSO_TICKET_SECRET=change-me
# Public (browser-facing) ssod_auth URL, not the docker-internal one.
SSOD_AUTH_PUBLIC_URL=https://auth.ssod.pro
# Docker-internal, server-to-server (TZ section 4 personal-key registry).
# Must match ssod_auth's own BIOGRAPHIA_KEY_API_KEY.
SSOD_AUTH_INTERNAL_URL=http://ssod-auth-internal:8000
BIOGRAPHIA_KEY_API_KEY=change-me

# Object storage for attachments (TZ section 9) - MinIO locally, any
# S3-compatible endpoint in production.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT_URL=http://biographia-minio-internal:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=biographia-attachments

# WebAuthn PRF provider (TZ section 4) - RP_ID must exactly match the
# browser's hostname (not scheme/port), ORIGIN must match exactly
# including scheme+port. In production this is the real domain, not
# "localhost" (which only works for local dev - see app/config.py).
WEBAUTHN_RP_ID=biographia.ssod.pro
WEBAUTHN_RP_NAME=Biographia
WEBAUTHN_ORIGIN=https://biographia.ssod.pro
